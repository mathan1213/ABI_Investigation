# Account Breach Investigation - Backend Configuration
ENVIRONMENT=development
APP_ENV=development

# Database configuration (defaults to SQLite in backend directory)
DATABASE_URL=sqlite:///./app.db

# Authentication & JWT Security (Required: minimum 16 characters)
JWT_SECRET=your-secure-jwt-secret-min-16-characters-here
ADMIN_EMAIL=admin@breach-investigation.local
ADMIN_PASSWORD=YourStrongAdminPassword2026!

# SMTP Email Service Configuration (Required for Email OTP verification in production)
# When APP_ENV=development and SMTP is unconfigured, OTP codes are printed to the console only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@breach-investigation.local

# Optional External Threat Intelligence Keys
# AbuseIPDB API key for real-time IP abuse scores (https://www.abuseipdb.com/)
ABUSEIPDB_KEY=

# VirusTotal API key for URL reputation & phishing detection (https://www.virustotal.com/)
VIRUSTOTAL_KEY=

# GitHub Personal Access Token (optional, for higher rate limits on repo checks)
GITHUB_TOKEN=
