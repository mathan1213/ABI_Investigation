# Account Breach Investigation - Backend Configuration
ENVIRONMENT=development

# Optional External API Keys (free tier keys)
# AbuseIPDB API key for real-time IP abuse score (https://www.abuseipdb.com/)
ABUSEIPDB_KEY=

# VirusTotal API key for URL reputation & phishing detection (https://www.virustotal.com/)
VIRUSTOTAL_KEY=

# GitHub Personal Access Token (optional, for higher rate limits on repo checks)
GITHUB_TOKEN=

# Telegram MTProto API Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
