# Account Breach Investigation - Backend Configuration
ENVIRONMENT=development
APP_ENV=development

# Database configuration (defaults to SQLite in backend directory)
DATABASE_URL=sqlite:///./app.db

# Authentication & JWT Security (Required: minimum 16 characters)
JWT_SECRET=your-secure-jwt-secret-min-16-characters-here

# Admin Account Seed Credentials (auto-created on startup if no admin exists)
ADMIN_EMAIL=admin@breach-investigation.local
ADMIN_PASSWORD=YourStrongAdminPassword2026!

# SMTP Email Configuration (Gmail SMTP for Registration Confirmation Emails)
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com/security)
# 2. Generate an App Password under Security -> App Passwords
# 3. Enter your full Gmail address and the 16-character App Password below (without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
# Optional aliases
# SMTP_USER=your_email@gmail.com
# SMTP_APP_PASSWORD=your_16_character_app_password
# SMTP_FROM=noreply@breach-investigation.local

# Optional External Threat Intelligence Keys
ABUSEIPDB_KEY=
VIRUSTOTAL_KEY=
GITHUB_TOKEN=
